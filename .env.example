# Every key is optional. Without a key the app runs in demo mode for that feature.

# Postgres connection string (Supabase, Neon, or any Postgres). Needed when deployed,
# so every phone and the office share the same data. Without it, local development
# uses a built-in database stored in .data/.
DATABASE_URL=

# Reads dropped documents (PDF or photo) and fills in the job form.
ANTHROPIC_API_KEY=

# Job-completed and password-reset emails. Use either SMTP or Resend.
# SMTP, e.g. Titan / Hostinger email: host smtp.titan.email, port 465, your mailbox and its password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Or Resend (https://resend.com). FROM must be on a verified domain.
RESEND_API_KEY=
# Sender shown to customers. With SMTP it must be the SMTP mailbox; defaults to SMTP_USER.
NOTIFY_EMAIL_FROM="Your Company <jobs@yourdomain.com.au>"

# Job-completed SMS via ClickSend (https://clicksend.com).
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
# Registered alphanumeric sender ID (max 11 characters), or leave blank for a shared number.
CLICKSEND_SENDER_ID=

# Optional: Google Geocoding for better Australian address search.
# Without it the app uses OpenStreetMap (free, lower quality, rate limited).
GOOGLE_MAPS_API_KEY=
